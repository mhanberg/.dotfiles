#!/usr/bin/env bash

set -uo pipefail

list_agent_panes() {
  local sep=$'\t'
  local fmt="#{pane_id}${sep}#{pane_current_command}${sep}#{session_name}${sep}#{window_index}${sep}#{pane_index}${sep}#{pane_title}"

  tmux list-panes -a -F "$fmt" 2>/dev/null |
    awk -F'\t' '
      $2 ~ /^\.?(claude|opencode|codex)/ {
        agent = $2
        sub(/^\./, "", agent)
        sub(/-wrapped.*/, "", agent)

        loc = $3 ":" $4 "." $5
        printf "%s\t%-8s  %-24s  %s\n", $1, agent, loc, $6
      }
    '
}

pick_pane() {
  local header="$1"

  fzf \
    --delimiter='\t' \
    --with-nth='2..' \
    --reverse \
    --border=none \
    --prompt='Agents> ' \
    --header="$header" \
    --preview='tmux capture-pane -ep -t {1}' \
    --preview-window='bottom,80%,border-top' \
    --bind='ctrl-t:toggle-preview'
}

switch_to() {
  local pane="$1"

  tmux select-window -t "$pane"
  tmux select-pane -t "$pane"
  if [[ -z "${TMUX:-}" ]]; then
    tmux attach -t "$pane"
  else
    tmux switch-client -t "$pane"
  fi
}

main() {
  local panes selection header

  panes="$(list_agent_panes)"

  if [[ -z "$panes" ]]; then
    header='No agents running'
  else
    header='[CTRL-T] Toggle Preview'
  fi

  # printf, not <<<: a here-string would append a trailing newline (blank fzf row)
  selection="$(printf '%s' "$panes" | pick_pane "$header")" || exit 0
  [[ -z "$selection" ]] && exit 0

  switch_to "${selection%%$'\t'*}"
}

main
